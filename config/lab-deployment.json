{
  "schema_version": 1,
  "namespace": "honeypots",
  "log_root": "/var/log/honeypots",
  "service_type": "NodePort",
  "mappings": [
    {
      "honeypot": "cowrie",
      "service": "ssh",
      "transport": "tcp",
      "release": "auto-mixed-01",
      "service_port": 22,
      "container_port": 2222
    },
    {
      "honeypot": "dionaea",
      "service": "http",
      "transport": "tcp",
      "release": "auto-mixed-01",
      "service_port": 80,
      "container_port": 80
    },
    {
      "honeypot": "dionaea",
      "service": "https",
      "transport": "tcp",
      "release": "auto-mixed-01",
      "service_port": 443,
      "container_port": 443
    },
    {
      "honeypot": "dionaea",
      "service": "smb",
      "transport": "tcp",
      "release": "auto-mixed-01",
      "service_port": 445,
      "container_port": 445
    },
    {
      "honeypot": "conpot",
      "service": "modbus",
      "transport": "tcp",
      "release": "ics-modbus-01",
      "service_port": 502,
      "container_port": 5020
    }
  ]
}
